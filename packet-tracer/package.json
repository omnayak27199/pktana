{
  "name": "pktana-packet-tracer",
  "version": "1.0.0",
  "description": "Cisco Packet Tracer-style network learning lab for Windows, macOS, and Linux",
  "author": "Omprakash <omnayak27199@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://pktana.online",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "online.pktana.packet-tracer",
    "productName": "pktana Packet Tracer",
    "copyright": "Copyright © 2026 Omprakash",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "VERSION",
      "css/**/*",
      "js/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "artifactName": "pktana-packet-tracer.${ext}"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "pktana-packet-tracer-setup.${ext}"
    },
    "linux": {
      "category": "Education",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] }
      ],
      "artifactName": "pktana-packet-tracer.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "pktana Packet Tracer"
    },
    "dmg": {
      "title": "pktana Packet Tracer ${version}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
